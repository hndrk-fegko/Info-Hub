# ===== Info-Hub .gitignore =====

# Config - enthält lokale Einstellungen
backend/config.php

# User data / Runtime-Daten - sollte nicht ins Repo
backend/data/settings.json
backend/data/tiles.json
backend/data/*.tmp
backend/data/*.tmp.*
backend/data/*.bak

# Uploads / Media-Runtime - benutzerspezifisch
backend/media/downloads/*
backend/media/images/*
backend/media/header/*
backend/media/backgrounds/*
!backend/media/downloads/.gitkeep
!backend/media/images/.gitkeep
!backend/media/header/.gitkeep
!backend/media/backgrounds/.gitkeep

# Logs
backend/logs/*
!backend/logs/.gitkeep

# Archive / Backups
backend/archive/*
!backend/archive/.gitkeep

# Generated files
index.html
index.html.tmp.*

# Build / Dist
dist/
build/
artifacts/

# ZIP / Archive artifacts
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.history/

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.rej
/tmp/
/temp/

# PHP
*.log
.phpunit.result.cache

# Lokale Test-/Probe-Dateien
tests/*.local.php
tests/local-*
tests/probe-*
tests/scratch-*
